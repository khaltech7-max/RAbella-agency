{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server.ts,src/data/rentalData.ts,src/lib/smsService.ts,src/lib/anniversaryBilling.ts,src/lib/pdfInvoiceBuilder.ts,supabase/migrations/**}"
    }
  },
  "crons": [
    {
      "path": "/api/sms/run-automated-checks",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|assets/|uploads/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
