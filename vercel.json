{
  "version": 2,
  "crons": [
    {
      "path": "/api/sms/run-automated-checks",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|assets/|uploads/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
