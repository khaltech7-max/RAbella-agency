# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Client-safe variables (used by @supabase/supabase-js in browser for Auth & RLS queries)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-only variables (used exclusively in server.ts for payment verification & admin operations; NEVER exposed to frontend)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# SOZURI SMS GATEWAY API CONFIGURATION (Server-only / Supabase Edge Function secrets — NEVER expose in frontend):
# Official API Endpoint: https://sozuri.net/api/v1/messaging
# Bearer Token Auth with payload: { project, from, to, message, type: 'transactional' }
SOZURI_API_KEY="your-sozuri-api-key"
SOZURI_PROJECT="ARABELLA"
SOZURI_SENDER_ID="ARABELLA"

# RESEND EMAIL API CONFIGURATION (Server-only secret for staff invitations & transactional alerts — NEVER expose in frontend):
# Get your API key at https://resend.com/api-keys
# To configure Resend as Supabase Custom SMTP in Project Settings > Authentication > SMTP:
#   Host: smtp.resend.com
#   Port: 465 (or 587)
#   User: resend
#   Pass: <your-resend-api-key>
#   Sender Email: onboarding@resend.dev (or your verified domain address)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Rentify Management <onboarding@resend.dev>"
