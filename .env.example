# APPLICATION URL CONFIGURATION:
# Public base URL where this application is hosted (used for self-referential links, callbacks, and API endpoints).
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION:
# Client-safe variables (used by @supabase/supabase-js in browser for Auth & RLS queries)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-only variables (used exclusively in server.ts for payment verification & admin operations; NEVER exposed to frontend)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# RESEND EMAIL API CONFIGURATION (Server-only secret for staff invitations & transactional alerts — NEVER expose in frontend):
# Get your API key at https://resend.com/api-keys
# To configure Resend as Supabase Custom SMTP in Project Settings > Authentication > SMTP:
#   Host: smtp.resend.com
#   Port: 465 (or 587)
#   User: resend
#   Pass: <your-resend-api-key>
#   Sender Email: onboarding@resend.dev (or your verified domain address)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Rentify Management <onboarding@resend.dev>"

# SOZURI SMS GATEWAY CONFIGURATION (Server-only secrets — NEVER expose in frontend):
# Register at https://sozuri.net and obtain project name, API key, and approved Sender ID.
SOZURI_PROJECT="your_sozuri_project_name"
SOZURI_API_KEY="your_sozuri_api_key"
SOZURI_SENDER_ID="ARABELLA"

# PAYHERO KENYA PAYMENT CONFIGURATION (Server-only secrets — Single API account supporting multiple PayBills):
PAYHERO_API_USERNAME="your_payhero_api_username"
PAYHERO_API_PASSWORD="your_payhero_api_password"
PAYHERO_BASIC_AUTH_TOKEN="your_payhero_basic_auth_token"
PAYHERO_ACCOUNT_ID="your_payhero_account_id"
PAYHERO_DEFAULT_CHANNEL_ID="your_payhero_default_channel_id"
PAYHERO_WEBHOOK_SECRET="your_payhero_webhook_secret"


